# Groq API key for the Kuro chat assistant (frontend/api/chat.js).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Upstash Redis for the guestbook (auto-added by Vercel Upstash integration).
# Copy from Vercel → Project → Settings → Environment Variables into .env.local for local dev.
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_KV_REST_API_READ_ONLY_TOKEN=

# Optional: GitHub token for higher API rate limits on /api/github-stats (Metadata read).
GITHUB_TOKEN=

# If the browser URL port differs from the Vite server (e.g. Cursor forwards 3003 → 3000), set:
# VITE_HMR_CLIENT_PORT=3003
