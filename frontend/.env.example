# Groq API key for the Kuro chat assistant (frontend/api/chat.js).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=
# Optional model overrides (defaults: openai/gpt-oss-120b, fallback openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Upstash Redis for guestbook, chat rate limits, and GitHub cache
# (auto-added by Vercel Upstash integration).
# Copy from Vercel → Project → Settings → Environment Variables into .env.local for local dev.
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_KV_REST_API_READ_ONLY_TOKEN=
# Aliases also accepted by guestbookStore.js:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# UPSTASH_REDIS_REST_READ_ONLY_TOKEN=

# Resend for the contact form (frontend/api/contact.js).
RESEND_API_KEY=
# Optional From address, e.g. Portfolio <hello@aryandani.com>
CONTACT_FROM_EMAIL=

# Optional: GitHub token for higher API rate limits on /api/github-stats (Metadata read).
GITHUB_TOKEN=

# If the browser URL port differs from the Vite server (e.g. Cursor forwards 3003 → 3000), set:
# VITE_HMR_CLIENT_PORT=3003
